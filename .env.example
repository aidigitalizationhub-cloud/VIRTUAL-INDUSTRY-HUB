# Server-only AI keys (never exposed to the browser)
GEMINI_API_KEY=

# Groq API Key (server-only; used for profile extraction and matching)
GROQ_API_KEY=

# Optional: override the Groq model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Credentials (anon key is safe for the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER-ONLY — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth — full migration target (Supabase Postgres shared via DATABASE_URL)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
VITE_BETTER_AUTH_URL=http://localhost:3000
DATABASE_URL=

# Comma-separated list of allowed CORS origins (server-side)
CORS_ORIGINS=http://localhost:3000
