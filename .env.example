# Server-only AI keys (never exposed to the browser)
GEMINI_API_KEY=

# Groq API Key (server-only; used for profile extraction and matching)
GROQ_API_KEY=

# Optional: override the Groq model (default: openai/gpt-oss-120b)
GROQ_MODEL=openai/gpt-oss-120b

# Supabase Credentials (anon key is safe for the client)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Supabase service-role key (SERVER-ONLY — never expose to the client)
SUPABASE_SERVICE_ROLE_KEY=

# Better Auth — full migration target (Supabase Postgres shared via DATABASE_URL)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
VITE_BETTER_AUTH_URL=http://localhost:3000

# IMPORTANT: Use the TRANSACTION POOLER URI, not the direct db.*.supabase.co host.
# Supabase Dashboard → Project Settings → Database → Connection string → URI → Transaction pooler.
# Correct shape (region may differ — copy exactly what the Dashboard shows):
#   DATABASE_URL="postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-<REGION>.pooler.supabase.com:6543/postgres?pgbouncer=true"
# The old "db.<PROJECT-REF>.supabase.co" host no longer resolves (ENOTFOUND) — do not use it.
DATABASE_URL=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Better Auth password-reset email delivery via Gmail SMTP (server-only)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Comma-separated list of allowed CORS origins (server-side)
CORS_ORIGINS=http://localhost:3000
